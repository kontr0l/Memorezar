    "Choose how you want to be notified during recitation. Default plays clean tones, Memes plays random funny sounds." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo quieres ser notificado durante la recitación. Predeterminado reproduce tonos limpios, Memes reproduce sonidos graciosos al azar."
          }
        }
      }
    },
    "Choose how you want to be notified during recitation. Mistake sounds play when you say the wrong word, correct sounds play after you fix a mistake, and completion sounds play when you finish." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cómo quieres ser notificado durante la recitación. Los sonidos de error se reproducen cuando dices la palabra incorrecta, los sonidos correctos se reproducen después de corregir un error y los sonidos de completado se reproducen cuando terminas."
          }
        }
      }
    },
